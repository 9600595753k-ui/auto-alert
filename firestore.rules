rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Functions
    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 200)) &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidTransaction(data, userId) {
      return data.userId == userId &&
             data.amountPaise is int && data.amountPaise > 0 &&
             data.type in ['DEBIT', 'CREDIT'] &&
             (!('status' in data) || data.status in ['COMPLETED', 'PENDING', 'FAILED', 'REFUNDED']) &&
             data.merchant is string && data.merchant.size() > 0 && data.merchant.size() <= 100 &&
             data.category is string && data.category.size() > 0 && data.category.size() <= 50 &&
             data.bankName is string && data.bankName.size() > 0 && data.bankName.size() <= 50 &&
             (!('fingerprint' in data) || (data.fingerprint is string && data.fingerprint.size() <= 128)) &&
             (!('referenceNumber' in data) || (data.referenceNumber is string && data.referenceNumber.size() <= 64)) &&
             (!('accountMasked' in data) || (data.accountMasked is string && data.accountMasked.size() <= 32)) &&
             (!('paymentMode' in data) || (data.paymentMode is string && data.paymentMode.size() <= 32)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 500)) &&
             (!('isExcluded' in data) || data.isExcluded is bool) &&
             (!('isRecurring' in data) || data.isRecurring is bool) &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidRecurring(data, userId) {
      return data.userId == userId &&
             data.merchantName is string && data.merchantName.size() > 0 && data.merchantName.size() <= 100 &&
             data.category is string && data.category.size() > 0 && data.category.size() <= 50 &&
             data.expectedAmountPaise is int && data.expectedAmountPaise > 0 &&
             data.frequency in ['DAILY', 'WEEKLY', 'MONTHLY', 'QUARTERLY', 'ANNUALLY'] &&
             data.status in ['ACTIVE', 'PAUSED', 'CANCELLED'] &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidBudget(data, userId) {
      return data.userId == userId &&
             data.category is string && data.category.size() > 0 && data.category.size() <= 50 &&
             data.monthlyLimitPaise is int && data.monthlyLimitPaise >= 0;
    }

    // User Profile Documents
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
                       incoming().userId == userId &&
                       incoming().keys().hasAll(['userId', 'createdAt']) &&
                       incoming().keys().hasOnly(['userId', 'email', 'displayName', 'createdAt', 'updatedAt']) &&
                       isValidUserProfile(incoming());

      allow update: if isOwner(userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'updatedAt']) &&
                       isValidUserProfile(incoming());

      allow delete: if isOwner(userId);

      // User Financial Transactions Subcollection
      match /transactions/{transactionId} {
        allow get, list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(transactionId) &&
                         incoming().userId == userId &&
                         incoming().keys().hasAll(['userId', 'amountPaise', 'type', 'merchant', 'category', 'bankName', 'createdAt']) &&
                         isValidTransaction(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(transactionId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['category', 'notes', 'isExcluded', 'isRecurring', 'status', 'updatedAt']) &&
                         isValidTransaction(incoming(), userId);

        allow delete: if isOwner(userId) && isValidId(transactionId);
      }

      // User Recurring Payments Subcollection
      match /recurring/{recurringId} {
        allow get, list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(recurringId) &&
                         incoming().userId == userId &&
                         incoming().keys().hasAll(['userId', 'merchantName', 'category', 'expectedAmountPaise', 'frequency', 'status', 'createdAt']) &&
                         isValidRecurring(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(recurringId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['expectedAmountPaise', 'frequency', 'nextDueDate', 'status', 'updatedAt']) &&
                         isValidRecurring(incoming(), userId);

        allow delete: if isOwner(userId) && isValidId(recurringId);
      }

      // User Category Budgets Subcollection
      match /budgets/{budgetId} {
        allow get, list: if isOwner(userId);

        allow create, update: if isOwner(userId) &&
                                 isValidId(budgetId) &&
                                 incoming().userId == userId &&
                                 incoming().keys().hasAll(['userId', 'category', 'monthlyLimitPaise']) &&
                                 isValidBudget(incoming(), userId);

        allow delete: if isOwner(userId) && isValidId(budgetId);
      }
    }
  }
}
