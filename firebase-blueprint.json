{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Google auth user ID" },
        "email": { "type": "string", "description": "User email address" },
        "displayName": { "type": "string", "description": "User display name" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp of creation" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp of update" }
      },
      "required": ["userId", "createdAt"]
    },
    "CloudTransaction": {
      "title": "CloudTransaction",
      "description": "Bank transaction record",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner user ID" },
        "fingerprint": { "type": "string", "description": "Deduplication hash" },
        "amountPaise": { "type": "integer", "description": "Amount in integer paise" },
        "type": { "type": "string", "enum": ["DEBIT", "CREDIT"], "description": "Transaction type" },
        "status": { "type": "string", "enum": ["COMPLETED", "PENDING", "FAILED", "REFUNDED"], "description": "Status" },
        "timestamp": { "type": "integer", "description": "Transaction epoch milliseconds" },
        "bankName": { "type": "string", "description": "Bank name (HDFC, SBI, etc.)" },
        "accountMasked": { "type": "string", "description": "Masked account number" },
        "merchant": { "type": "string", "description": "Merchant or beneficiary name" },
        "category": { "type": "string", "description": "Spending category" },
        "paymentMode": { "type": "string", "description": "UPI, CARD, NET_BANKING, etc." },
        "referenceNumber": { "type": "string", "description": "Bank reference number" },
        "notes": { "type": "string", "description": "User notes" },
        "isExcluded": { "type": "boolean", "description": "Whether excluded from calculations" },
        "isRecurring": { "type": "boolean", "description": "Whether recurring AutoPay" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Update timestamp" }
      },
      "required": ["userId", "amountPaise", "type", "merchant", "category", "bankName", "createdAt"]
    },
    "CloudRecurringPayment": {
      "title": "CloudRecurringPayment",
      "description": "Recurring payment schedule",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner user ID" },
        "merchantName": { "type": "string", "description": "Merchant or biller name" },
        "category": { "type": "string", "description": "Category" },
        "expectedAmountPaise": { "type": "integer", "description": "Expected amount in paise" },
        "frequency": { "type": "string", "enum": ["DAILY", "WEEKLY", "MONTHLY", "QUARTERLY", "ANNUALLY"], "description": "Frequency" },
        "nextDueDate": { "type": "integer", "description": "Next due timestamp in millis" },
        "status": { "type": "string", "enum": ["ACTIVE", "PAUSED", "CANCELLED"], "description": "Status" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Update timestamp" }
      },
      "required": ["userId", "merchantName", "category", "expectedAmountPaise", "frequency", "status", "createdAt"]
    },
    "CloudBudget": {
      "title": "CloudBudget",
      "description": "Category monthly spending budget",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner user ID" },
        "category": { "type": "string", "description": "Budget category" },
        "monthlyLimitPaise": { "type": "integer", "description": "Monthly limit in paise" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Update timestamp" }
      },
      "required": ["userId", "category", "monthlyLimitPaise"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile documents"
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": "CloudTransaction",
      "description": "User's financial transactions"
    },
    "/users/{userId}/recurring/{recurringId}": {
      "schema": "CloudRecurringPayment",
      "description": "User's recurring payment commitments"
    },
    "/users/{userId}/budgets/{budgetId}": {
      "schema": "CloudBudget",
      "description": "User's category budgets"
    }
  }
}
